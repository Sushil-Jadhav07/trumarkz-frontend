# Existing application endpoints (set for your deployment).
VITE_API_BASE_URL=
VITE_VERIFICATION_API_URL=
VITE_FRONTEND_URL=

# Public Web Push key. No default value is provided.
VITE_FIREBASE_VAPID_PUBLIC_KEY=

# Optional until Firebase Web App setup is completed. Copy the public Web App
# configuration from the same Firebase project as the VAPID key/backend sender.
# Messaging requires API_KEY, PROJECT_ID, MESSAGING_SENDER_ID and APP_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
